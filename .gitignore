# ============================================================
# LeadPing AI — Root .gitignore
# ============================================================

# Dependencies
**/node_modules/
**/vendor/
package-lock.json.backup

# Environment & Sensitive Files
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
auth.json

# Build & Compilation Artifacts
**/dist/
**/build/
**/out/
.vite/
**/.vite/
*.tsbuildinfo

# Databases & Local Data
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
leadping.sqlite
backend/database/*.sqlite
!backend/database/.gitignore

# Logs & Debugging
*.log
**/*.log
backend/storage/logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel Framework Generated Cache & Storage
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/app/*
!backend/storage/app/.gitignore
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/*.key

# Testing & Coverage
.phpunit.cache/
.phpunit.result.cache
coverage/
*.lcov

# IDE, OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.cursor/
.codex/
